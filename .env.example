# Copy to `.env` for local builds (never commit real secrets).
# Astro inlines `PUBLIC_*` at build time; there is no Worker runtime secrets layer
# for this static-assets deploy.

# --- Required in Cloudflare Workers Builds (production) ---

# Canonical site origin (HTTPS, no trailing slash). Single setting for
# Astro `site`, canonicals, sitemap, robots.txt, llms.txt, JSON-LD, OG, IndexNow.
# Unset → DEFAULT_SITE_URL in src/config/site.ts (current workers.dev).
# Custom domain cutover: docs/CUSTOM-DOMAIN.md — do not hardcode hosts elsewhere.
# Do NOT put PUBLIC_* in wrangler top-level vars (breaks `wrangler preview`).
PUBLIC_SITE_URL=https://file-converter-tools.hammadiqbal117.workers.dev

# Public support email (Contact / Privacy / Terms / footer / Organization JSON-LD).
# Defaults to hammadiqbal117@gmail.com in src/config/site.ts when unset.
PUBLIC_CONTACT_EMAIL=hammadiqbal117@gmail.com

# --- Recommended in Cloudflare Workers Builds ---

# Pin Node for Workers Builds / CI (matches package.json engines / .nvmrc).
NODE_VERSION=22.22.0

# Google Search Console HTML meta verification token (content= value).
# Already verified on this property; default baked in site.ts if unset.
PUBLIC_GSC_VERIFICATION=0-q_NxhBgfgCm4WOLfbe9VrHrjbLzaxh8SXsbo2Q-UU

# Legacy alias accepted by site.ts (prefer PUBLIC_GSC_VERIFICATION).
# PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools meta verification token.
PUBLIC_BING_VERIFICATION=

# Google Analytics 4 measurement ID (empty override disables gtag.js).
# Default in site.ts matches the live Worker measurement ID.
PUBLIC_GA4_MEASUREMENT_ID=G-L73MEN86ZY

# Google AdSense publisher ID, e.g. ca-pub-XXXXXXXX (empty = ads off).
PUBLIC_ADSENSE_PUBLISHER_ID=

# IndexNow key (32-char hex). Must match public/<key>.txt at site root.
PUBLIC_INDEXNOW_KEY=e0d80dcb289204f10564144f215e4a8e

# Deploy/post-deploy ping uses INDEXNOW_KEY (same value). Set INDEXNOW_DISABLE=1
# on preview deploys if you do not want to ping.
INDEXNOW_KEY=e0d80dcb289204f10564144f215e4a8e
# INDEXNOW_DISABLE=

# --- Optional: EmailJS contact form (/contact/) ---
# All three must be set to render the form; otherwise mailto fallback only.
# Use the EmailJS *public* key only — never commit the private key.
# Template vars: {{from_name}}, {{reply_to}}, {{message}}, {{page_url}}, {{site_name}}
# Details: docs/CONTACT-EMAILJS.md
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=

# --- Local / CI only (not needed in Cloudflare build settings) ---

# Set to 1 to skip rebuilding when running npm run proof locally.
# PROOF_SKIP_BUILD=
