{
  // Pure static-assets Worker — no Cloudflare Astro adapter, no Worker script,
  // no SESSION/IMAGES bindings. Deploy with: npm run build && npx wrangler deploy
  //
  // Build-time PUBLIC_* (Astro inlines during `npm run build`) belong in
  // Cloudflare Workers Builds → Variables — same keys as `.env.example`
  // (PUBLIC_SITE_URL, PUBLIC_GSC_VERIFICATION, PUBLIC_GA4_MEASUREMENT_ID,
  // PUBLIC_INDEXNOW_KEY, etc.). Do not put them in wrangler `vars` for this
  // assets-only Worker: preview deploys use `npx wrangler preview`, which
  // then requires a `previews.vars` block.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "file-converter-tools",
  // Current compatibility date for Workers static assets
  "compatibility_date": "2026-10-19",
  "assets": {
    // Astro SSG output (no adapter → dist/, not dist/client/)
    "directory": "./dist",
    // Serve nearest 404.html for unknown paths (src/pages/404.astro)
    "not_found_handling": "404-page",
    // Match Astro trailingSlash: 'always' (folder index.html → trailing slash)
    "html_handling": "force-trailing-slash"
  }
}
