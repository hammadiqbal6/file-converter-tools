---
import ToolChrome from './ToolChrome.astro';
---
<ToolChrome accept=".pdf,application/pdf" inputLabel="Bank statement PDF (text-based)" />
<script>
  import { downloadText } from '../../lib/download';
  const root = document.querySelector('[data-tool-root]');
  let lastOut = '';
  root.querySelector('[data-convert]')?.addEventListener('click', async () => {
    const status = root.querySelector('[data-status]');
    const file = root.querySelector('[data-file-input]')?.files?.[0];
    if (!file) {
      status.dataset.tone = 'error';
      status.textContent = 'Choose a PDF.';
      return;
    }
    status.textContent = 'Loading pdf.js…';
    try {
      const pdfjs = await import('pdfjs-dist');
      pdfjs.GlobalWorkerOptions.workerSrc = new URL(
        'pdfjs-dist/build/pdf.worker.min.mjs',
        import.meta.url,
      ).toString();
      const { extractStatementCsv, PDF_BANK_LIMITS } = await import('../../lib/converters/pdf-bank');
      const data = new Uint8Array(await file.arrayBuffer());
      const doc = await pdfjs.getDocument({ data, useSystemFonts: true }).promise;
      const pages = [];
      for (let p = 1; p <= doc.numPages; p++) {
        const page = await doc.getPage(p);
        const content = await page.getTextContent();
        const items = content.items
          .filter((it) => it.str && it.transform)
          .map((it) => ({
            str: it.str,
            x: it.transform[4],
            y: it.transform[5],
            width: it.width || 0,
            height: it.height || 0,
          }));
        pages.push({ page: p, items });
      }
      lastOut = extractStatementCsv(pages);
      root.querySelector('[data-output]').value = lastOut.slice(0, 12000);
      root.querySelector('[data-download]').disabled = false;
      root.querySelector('[data-copy]').disabled = false;
      root.querySelector('[data-preview]').innerHTML = `<p><strong>Limits</strong></p><ul>${PDF_BANK_LIMITS.map((l) => `<li>${l}</li>`).join('')}</ul>`;
      status.dataset.tone = 'success';
      status.textContent = `Extracted ${doc.numPages} page(s) locally. Verify amounts.`;
    } catch (e) {
      status.dataset.tone = 'error';
      status.textContent = e.message || String(e);
    }
  });
  root.querySelector('[data-download]')?.addEventListener('click', () => downloadText(lastOut, 'statement.csv', 'text/csv'));
  root.querySelector('[data-copy]')?.addEventListener('click', () => navigator.clipboard.writeText(lastOut));
</script>
