---
import { siteConfig } from '../../config/site';

const usesAnalytics = Boolean(siteConfig.ga4MeasurementId);
const usesAds = Boolean(siteConfig.adsensePublisherId);
---

<div class="cookie-banner" id="cookie-banner" role="dialog" aria-label="Cookie notice" hidden>
  <p>
    We store a local preference when you dismiss this notice (`lf_cookie_notice_v1`).
    {
      usesAnalytics && (
        <>
          {' '}
          Google Analytics (GA4) loads for aggregate usage metrics when configured — see our{' '}
          <a href="/privacy/">Privacy Policy</a>.
        </>
      )
    }
    {
      !usesAnalytics && (
        <>
          {' '}
          Analytics stays off until a measurement ID is configured. See our <a href="/privacy/">Privacy Policy</a>.
        </>
      )
    }
    {
      usesAds
        ? ' Advertising cookies may be used when AdSense is enabled. EEA/UK/CH visitors need a Google-certified CMP before personalized ads.'
        : ' Personalized ads stay off until AdSense and a Google-certified CMP (EEA/UK/CH) are configured.'
    }
  </p>
  <div class="btn-group">
    <button type="button" class="btn btn-primary" id="cookie-accept">OK</button>
    <a class="btn btn-secondary" href="/privacy/">Privacy</a>
  </div>
</div>

<script>
  const key = 'lf_cookie_notice_v1';
  const el = document.getElementById('cookie-banner');
  if (el && !localStorage.getItem(key)) {
    el.hidden = false;
    el.classList.add('is-visible');
  }
  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    localStorage.setItem(key, '1');
    el?.classList.remove('is-visible');
    if (el) el.hidden = true;
  });
</script>
