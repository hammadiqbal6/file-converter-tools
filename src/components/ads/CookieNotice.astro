---
import { siteConfig } from '../../config/site';

interface Props {
  /** Delay showing the banner so it is not the LCP element */
  defer?: boolean;
}

const { defer = true } = Astro.props;
const usesAnalytics = Boolean(siteConfig.ga4MeasurementId);
const usesAds = Boolean(siteConfig.adsensePublisherId);
const measurementId = siteConfig.ga4MeasurementId || '';
---

<div
  class="cookie-banner"
  id="cookie-banner"
  role="dialog"
  aria-label="Cookie and analytics preferences"
  hidden
  data-defer={defer ? '1' : '0'}
  data-measurement-id={measurementId}
>
  <p>
    {
      usesAnalytics
        ? 'Analytics (not your files) load only if you Accept. Reject keeps GA off — see Privacy.'
        : 'Local preference only. Analytics stay off until configured — see Privacy.'
    }
    {usesAds ? ' Ads may use cookies when enabled.' : ''}
  </p>
  <div class="btn-group">
    {
      usesAnalytics ? (
        <button type="button" class="btn btn-secondary" id="cookie-reject">Reject</button>
      ) : null
    }
    <button type="button" class="btn btn-primary" id="cookie-accept">
      {usesAnalytics ? 'Accept' : 'OK'}
    </button>
    <a class="btn btn-secondary" href="/privacy/">Privacy</a>
  </div>
</div>

<script>
  const CONSENT_KEY = 'lf_analytics_consent_v1';
  const LEGACY_KEY = 'lf_cookie_notice_v1';
  const el = document.getElementById('cookie-banner');
  const root = document.documentElement;
  const measurementId = el?.getAttribute('data-measurement-id') || '';

  function setBannerSpace(on) {
    root.style.setProperty('--cookie-banner-offset', on ? '56px' : '0px');
    root.classList.toggle('has-cookie-banner', on);
  }

  function showBanner() {
    if (!el) return;
    el.hidden = false;
    el.classList.add('is-visible');
    setBannerSpace(true);
  }

  function hideBanner() {
    el?.classList.remove('is-visible');
    if (el) el.hidden = true;
    setBannerSpace(false);
  }

  function loadAnalytics() {
    if (!measurementId || window.__lfGaLoaded) return;
    window.__lfGaLoaded = true;
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    window.gtag = gtag;
    gtag('js', new Date());
    gtag('config', measurementId);
    const s = document.createElement('script');
    s.async = true;
    s.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
    document.head.appendChild(s);
  }

  function scheduleBanner() {
    if (!el) return;
    const deferred = el.getAttribute('data-defer') === '1';
    if (!deferred) {
      showBanner();
      return;
    }
    const schedule =
      typeof requestIdleCallback === 'function'
        ? (cb) => requestIdleCallback(cb, { timeout: 4000 })
        : (cb) => setTimeout(cb, 2500);
    schedule(showBanner);
    const unlock = () => {
      showBanner();
      window.removeEventListener('scroll', unlock);
      window.removeEventListener('pointerdown', unlock);
    };
    window.addEventListener('scroll', unlock, { once: true, passive: true });
    window.addEventListener('pointerdown', unlock, { once: true });
  }

  // Migrate away from dismiss-only legacy key so users get a real Accept/Reject choice.
  if (localStorage.getItem(LEGACY_KEY) && !localStorage.getItem(CONSENT_KEY)) {
    localStorage.removeItem(LEGACY_KEY);
  }

  const consent = localStorage.getItem(CONSENT_KEY);
  if (consent === 'granted') {
    loadAnalytics();
  } else if (consent === 'denied') {
    // Banner stays hidden; analytics stay off.
  } else if (!measurementId) {
    // No analytics configured — informational dismiss only (legacy OK path).
    if (!localStorage.getItem(LEGACY_KEY)) scheduleBanner();
  } else {
    scheduleBanner();
  }

  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    if (measurementId) {
      localStorage.setItem(CONSENT_KEY, 'granted');
      localStorage.removeItem(LEGACY_KEY);
      loadAnalytics();
    } else {
      localStorage.setItem(LEGACY_KEY, '1');
    }
    hideBanner();
  });

  document.getElementById('cookie-reject')?.addEventListener('click', () => {
    localStorage.setItem(CONSENT_KEY, 'denied');
    localStorage.removeItem(LEGACY_KEY);
    hideBanner();
  });
</script>
