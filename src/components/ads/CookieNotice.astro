---
import { siteConfig } from '../../config/site';

interface Props {
  /** Delay showing the banner so it is not the LCP element */
  defer?: boolean;
}

const { defer = true } = Astro.props;
const usesAnalytics = Boolean(siteConfig.ga4MeasurementId);
const usesAds = Boolean(siteConfig.adsensePublisherId);
---

<div
  class="cookie-banner"
  id="cookie-banner"
  role="dialog"
  aria-label="Cookie notice"
  hidden
  data-defer={defer ? '1' : '0'}
>
  <p>
    {
      usesAnalytics
        ? 'Local dismiss preference only. Analytics (not your files) may load — see Privacy.'
        : 'Local dismiss preference only. Analytics stay off until configured — see Privacy.'
    }
    {usesAds ? ' Ads may use cookies when enabled.' : ''}
  </p>
  <div class="btn-group">
    <button type="button" class="btn btn-primary" id="cookie-accept">OK</button>
    <a class="btn btn-secondary" href="/privacy/">Privacy</a>
  </div>
</div>

<script>
  const key = 'lf_cookie_notice_v1';
  const el = document.getElementById('cookie-banner');
  const root = document.documentElement;

  function setBannerSpace(on) {
    root.style.setProperty('--cookie-banner-offset', on ? '56px' : '0px');
    root.classList.toggle('has-cookie-banner', on);
  }

  function showBanner() {
    if (!el || localStorage.getItem(key)) return;
    el.hidden = false;
    el.classList.add('is-visible');
    setBannerSpace(true);
  }

  function hideBanner() {
    el?.classList.remove('is-visible');
    if (el) el.hidden = true;
    setBannerSpace(false);
  }

  if (el) {
    const deferred = el.getAttribute('data-defer') === '1';
    if (deferred) {
      const schedule =
        typeof requestIdleCallback === 'function'
          ? (cb) => requestIdleCallback(cb, { timeout: 4000 })
          : (cb) => setTimeout(cb, 2500);
      schedule(showBanner);
      const unlock = () => {
        showBanner();
        window.removeEventListener('scroll', unlock);
        window.removeEventListener('pointerdown', unlock);
      };
      window.addEventListener('scroll', unlock, { once: true, passive: true });
      window.addEventListener('pointerdown', unlock, { once: true });
    } else {
      showBanner();
    }
  }

  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    localStorage.setItem(key, '1');
    hideBanner();
  });
</script>
