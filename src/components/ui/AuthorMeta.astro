---
import { siteConfig } from '../../config/site';

export interface Props {
  lastUpdated?: string;
  lastReviewed?: string;
  authorName?: string;
  authorRole?: string;
}

const {
  lastUpdated = siteConfig.buildDate,
  lastReviewed = lastUpdated,
  authorName = siteConfig.defaultAuthor.name,
  authorRole = siteConfig.defaultAuthor.role,
} = Astro.props;
---

<p class="meta-row author-meta">
  <span>
    <strong>Author:</strong>{' '}
    <a href="/authors/" rel="author">{authorName}</a>
    {authorRole ? ` (${authorRole})` : ''}
  </span>
  <span>
    <strong>Last updated:</strong>{' '}
    <time datetime={lastUpdated}>{lastUpdated}</time>
  </span>
  {
    lastUpdated !== lastReviewed ? (
      <span>
        <strong>Last reviewed:</strong> <time datetime={lastReviewed}>{lastReviewed}</time>
      </span>
    ) : null
  }
</p>
