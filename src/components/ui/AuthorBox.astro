---
import { siteConfig } from '../../config/site';
interface Props {
  reviewed?: boolean;
  dateModified: string;
  datePublished?: string;
}
const { reviewed = true, dateModified, datePublished } = Astro.props;
---
<aside class="author-box" aria-label="Authorship">
  <p>
    <strong>{siteConfig.defaultAuthor.name}</strong>
    {siteConfig.defaultAuthor.fullName !== siteConfig.defaultAuthor.name
      ? ` (${siteConfig.defaultAuthor.fullName})`
      : ''}{' '}
    — {siteConfig.defaultAuthor.role}
  </p>
  <p class="meta-row">
    {datePublished && <span>Published: <time datetime={datePublished}>{datePublished}</time></span>}
    <span>Last updated: <time datetime={dateModified}>{dateModified}</time></span>
    {reviewed && <span>Reviewed for accuracy against cited format specs.</span>}
  </p>
  <p><a href="/authors/">About the authors</a> · <a href="/methodology/">Editorial methodology</a></p>
</aside>
