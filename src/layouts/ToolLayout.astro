---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import AuthorBox from '../components/ui/AuthorBox.astro';
import { siteConfig, absoluteUrl } from '../config/site';
import { categories, getTool, toolPath, type ToolDefinition } from '../data/tools';
import { guides } from '../data/guides';

interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
const cat = categories[tool.category];
const relatedTools = tool.related.map((s) => getTool(s)).filter(Boolean);
const relatedGuides = guides.filter((g) => tool.relatedGuides.includes(g.slug));

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
        { '@type': 'ListItem', position: 2, name: 'Tools', item: absoluteUrl('/tools/') },
        { '@type': 'ListItem', position: 3, name: cat.name, item: absoluteUrl(`/category/${cat.slug}/`) },
        { '@type': 'ListItem', position: 4, name: tool.name, item: absoluteUrl(toolPath(tool.slug)) },
      ],
    },
    {
      '@type': 'WebApplication',
      name: tool.name,
      url: absoluteUrl(toolPath(tool.slug)),
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any (modern web browser)',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description: tool.description,
      datePublished: tool.datePublished,
      dateModified: tool.dateModified,
      isAccessibleForFree: true,
    },
  ],
};

const prefetch = [
  ...relatedTools.slice(0, 2).map((t) => toolPath(t!.slug)),
  ...relatedGuides.slice(0, 1).map((g) => `/guides/${g.slug}/`),
];
---

<BaseLayout
  title={tool.title}
  description={tool.description}
  canonicalPath={toolPath(tool.slug)}
  jsonLd={structuredData}
  prefetch={prefetch.slice(0, 1)}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { name: 'Home', href: '/' },
        { name: 'Tools', href: '/tools/' },
        { name: cat.name, href: `/category/${cat.slug}/` },
        { name: tool.shortName },
      ]}
    />

    <header class="hero" style="padding-block:0 1rem">
      <p class="eyebrow">Free · Private · In-browser</p>
      <h1>{tool.h1}</h1>
      <p class="lead privacy-note"><strong>Privacy:</strong> your file never leaves your device.</p>
    </header>

    <section class="tool-shell" aria-label="Converter tool">
      <slot name="tool" />
    </section>

    <AdSlot placement="below-tool" />

    <article class="content-prose">
      <div class="answer-box">
        <p>{tool.answerFirst}</p>
      </div>

      <div class="takeaways">
        <h2>Key takeaways</h2>
        <ul>
          {tool.takeaways.map((t) => <li>{t}</li>)}
        </ul>
      </div>

      <h2>How to use this {tool.primaryKeyword} tool</h2>
      <ol>
        {tool.howToSteps.map((s) => <li>{s}</li>)}
      </ol>

      <h2>How the conversion works</h2>
      <p>{tool.method}</p>

      <h2>Worked example</h2>
      <p set:html={tool.workedExample.replace(/\n/g, '<br/>').replace(/```([\s\S]*?)```/g, '<pre><code>$1</code></pre>')} />

      {
        tool.comparisonTable && (
          <>
            <h2>Format comparison</h2>
            <table>
              <thead>
                <tr>
                  {tool.comparisonTable.headers.map((h) => (
                    <th scope="col">{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {tool.comparisonTable.rows.map((row) => (
                  <tr>
                    {row.map((cell) => (
                      <td>{cell}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </>
        )
      }

      <h2>Supported formats & limits</h2>
      <p>
        <strong>Input:</strong> {tool.inputFormats.join(', ')} · <strong>Output:</strong>{' '}
        {tool.outputFormats.join(', ')}
      </p>
      <ul>
        {tool.limits.map((l) => <li>{l}</li>)}
      </ul>

      <h2>Common mistakes</h2>
      <ul>
        {tool.mistakes.map((m) => <li>{m}</li>)}
      </ul>

      <h2>Troubleshooting</h2>
      <p>
        If conversion fails, check that the file extension matches a supported input, open the file in a text editor
        (for data formats) to confirm it is not truncated, and retry after refreshing so the on-demand library can
        reload. Still stuck? See our <a href="/guides/privacy-first-conversion/">privacy-first conversion guide</a> and{' '}
        <a href="/contact/">contact</a> us with the error message only — never send confidential files.
      </p>

      <h2>Privacy note</h2>
      <p class="privacy-note">
        Your file never leaves your device. {siteConfig.name} runs this converter in your browser
        {tool.library ? ` (lazy-loading ${tool.library} after you interact)` : ''}. We do not upload, store, or transmit
        your content to a server for conversion.
      </p>

      <section class="faq" aria-label="FAQ">
        <h2>FAQ</h2>
        {tool.faqs.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </section>

      <h2>Sources</h2>
      <ul>
        {tool.sources.map((s) => (
          <li>
            <a href={s.href} rel="noopener noreferrer">{s.label}</a>
          </li>
        ))}
      </ul>

      <AuthorBox datePublished={tool.datePublished} dateModified={tool.dateModified} />
    </article>

    <section class="related" aria-label="Related tools">
      <h2>Related converters</h2>
      <div class="card-grid">
        {relatedTools.map(
          (t) =>
            t && (
              <a class="tool-card" href={toolPath(t.slug)}>
                <h3>{t.name}</h3>
                <p>{t.description.slice(0, 110)}…</p>
              </a>
            ),
        )}
      </div>
    </section>

    {
      relatedGuides.length > 0 && (
        <section class="related" aria-label="Related guides">
          <h2>Related guides</h2>
          <div class="card-grid">
            {relatedGuides.map((g) => (
              <a class="tool-card" href={`/guides/${g.slug}/`}>
                <h3>{g.title}</h3>
                <p>{g.description}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      tool.embeddable && (
        <section class="related content-prose">
          <h2>Embed this tool</h2>
          <p>
            Add a privacy-friendly embed to your docs (attribution required). Files still convert in the visitor’s
            browser.
          </p>
          <pre><code>{`<iframe src="${absoluteUrl(`/embed/${tool.slug}/`)}" title="${tool.name}" loading="lazy" style="width:100%;min-height:420px;border:1px solid #cfd9d7;border-radius:8px"></iframe>
<p>Converter by <a href="${absoluteUrl(toolPath(tool.slug))}">${siteConfig.name}</a></p>`}</code></pre>
        </section>
      )
    }
  </div>
</BaseLayout>
