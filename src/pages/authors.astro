---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { siteConfig, absoluteUrl } from '../config/site';

const description =
  'Meet Hammad, maintainer of LocalFile Convert — private in-browser file converters with cited format specs and honest limits.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'Authors & reviewers',
  url: absoluteUrl('/authors/'),
  mainEntity: { '@id': siteConfig.personId },
};
---
<BaseLayout title="Authors & Reviewers" description={description} canonicalPath="/authors/" jsonLd={jsonLd}>
  <div class="container content-prose">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Authors' }]} />
    <h1>Authors & reviewers</h1>
    <div class="author-box">
      <p><strong>{siteConfig.defaultAuthor.name}</strong> ({siteConfig.defaultAuthor.fullName})</p>
      <p>{siteConfig.defaultAuthor.role}</p>
      <p>{siteConfig.defaultAuthor.bio}</p>
      <p>
        Profiles:{' '}
        {siteConfig.authorSameAs.map((href, i) => (
          <>
            {i > 0 && ' · '}
            <a href={href} rel="noopener noreferrer">{href.replace('https://', '')}</a>
          </>
        ))}
      </p>
    </div>
    <p>Contact: <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a></p>
  </div>
</BaseLayout>
