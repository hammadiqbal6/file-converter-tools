---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { siteConfig, absoluteUrl } from '../config/site';

const description =
  'Meet Hammad Iqbal, maintainer of LocalFile Convert — private in-browser file converters with cited format specs and honest limits.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'Authors & reviewers',
  url: absoluteUrl('/authors/'),
  mainEntity: { '@id': siteConfig.personId },
};
---
<BaseLayout title="Authors & Reviewers" description={description} canonicalPath="/authors/" jsonLd={jsonLd}>
  <div class="container content-prose">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Authors' }]} />
    <h1>Authors & reviewers</h1>
    <div class="answer-box">
      <p>
        {siteConfig.defaultAuthor.fullName} builds and reviews every converter and guide on {siteConfig.name}. Bylines use
        the short name “{siteConfig.defaultAuthor.name}” and link here. There are no guest authors or invented credentials.
      </p>
    </div>
    <div class="author-box">
      <p><strong>{siteConfig.defaultAuthor.name}</strong> ({siteConfig.defaultAuthor.fullName})</p>
      <p>{siteConfig.defaultAuthor.role}</p>
      <p>{siteConfig.defaultAuthor.bio}</p>
      <p>
        Profiles:{' '}
        {siteConfig.authorSameAs.map((href, i) => (
          <>
            {i > 0 && ' · '}
            <a href={href} rel="noopener noreferrer">{href.replace('https://', '')}</a>
          </>
        ))}
      </p>
    </div>
    <h2>What “review” means here</h2>
    <p>
      Before a tool ships, fixtures pass Vitest, limits are written in plain language, and at least one worked example is
      reproducible in the browser UI. Guides cite primary format docs (YAML, JSON, TOML, PDF, HEIF, STL, etc.) rather than
      anonymous forum numbers.
    </p>
    <h2>Contact</h2>
    <p>
      Corrections and feature requests:
      <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a> ·
      <a href="/contact/">Contact form</a> · <a href="/methodology/">Methodology</a>
    </p>
  </div>
</BaseLayout>
