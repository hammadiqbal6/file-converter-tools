---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { siteConfig, isEmailjsConfigured, absoluteUrl } from '../config/site';

const description = `Contact ${siteConfig.name} — email support for tool questions (never send confidential files).`;
const emailjsReady = isEmailjsConfigured();
const pageUrl = absoluteUrl('/contact/');
const maxMessage = 2000;
---
<BaseLayout title="Contact" description={description} canonicalPath="/contact/">
  <div class="container content-prose">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Contact' }]} />
    <h1>Contact</h1>
    <div class="answer-box">
      <p>
        Questions about a converter, a bug, or documentation?
        {emailjsReady ? ' Send a short message below, or email us.' : ' Email us using the address on this page.'}
        {' '}
        <strong>Do not attach confidential files</strong> — describe the error message instead.
        Conversions never require emailing us your documents. Your file never leaves your device when you use the tools.
      </p>
    </div>

    {
      emailjsReady && (
        <form
          id="contact-form"
          class="contact-form"
          novalidate
          data-service-id={siteConfig.emailjs.serviceId}
          data-template-id={siteConfig.emailjs.templateId}
          data-public-key={siteConfig.emailjs.publicKey}
          data-site-name={siteConfig.name}
          data-page-url={pageUrl}
          data-max-message={String(maxMessage)}
        >
          <div class="field">
            <label for="contact-name">Name</label>
            <input
              id="contact-name"
              name="from_name"
              type="text"
              autocomplete="name"
              required
              maxlength="120"
            />
          </div>
          <div class="field">
            <label for="contact-email">Email</label>
            <input
              id="contact-email"
              name="reply_to"
              type="email"
              autocomplete="email"
              required
              maxlength="200"
              inputmode="email"
            />
          </div>
          <div class="field">
            <label for="contact-message">Message</label>
            <textarea
              id="contact-message"
              name="message"
              required
              maxlength={maxMessage}
              rows="6"
              placeholder="Tool URL, browser/OS, and exact error text (no file contents)."
            ></textarea>
            <p class="meta-row">Max {maxMessage} characters. Do not paste confidential file contents.</p>
          </div>
          {/* Honeypot — leave empty. Hidden from assistive tech and sighted users. */}
          <div class="hp" aria-hidden="true">
            <label for="contact-company">Company</label>
            <input
              id="contact-company"
              name="company"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>
          <p id="contact-status" class="status" role="status" aria-live="polite"></p>
          <div class="btn-group">
            <button type="submit" id="contact-submit" class="btn btn-primary">Send message</button>
          </div>
        </form>
      )
    }

    <h2>{emailjsReady ? 'Email directly' : 'Email'}</h2>
    <p>
      {emailjsReady
        ? 'You can always reach us at '
        : 'Reach us at '}
      <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
      {emailjsReady ? ' (mailto works if the form is unavailable or JavaScript is off).' : '.'}
      {' '}Do not attach confidential files.
    </p>

    <h2>What to include</h2>
    <ul>
      <li>Tool URL</li>
      <li>Browser and OS</li>
      <li>Exact error text (no file contents)</li>
    </ul>
  </div>

  {
    emailjsReady && (
      <script is:inline>
        (() => {
          const form = document.getElementById('contact-form');
          if (!form) return;
          const statusEl = document.getElementById('contact-status');
          const submitBtn = document.getElementById('contact-submit');
          const THROTTLE_MS = 60000;
          const STORAGE_KEY = 'lfc_contact_last_send';
          const endpoint = 'https://api.emailjs.com/api/v1.0/email/send';

          function setStatus(msg, tone) {
            if (!statusEl) return;
            statusEl.textContent = msg || '';
            if (tone) statusEl.setAttribute('data-tone', tone);
            else statusEl.removeAttribute('data-tone');
          }

          function lastSend() {
            try {
              return Number(localStorage.getItem(STORAGE_KEY) || '0') || 0;
            } catch {
              return 0;
            }
          }

          function markSent() {
            try {
              localStorage.setItem(STORAGE_KEY, String(Date.now()));
            } catch {
              /* ignore quota / private mode */
            }
          }

          form.addEventListener('submit', async (event) => {
            event.preventDefault();
            const hp = form.querySelector('#contact-company');
            if (hp && String(hp.value || '').trim()) {
              setStatus('Thanks — your message was sent.', 'success');
              form.reset();
              return;
            }

            const nameInput = form.querySelector('#contact-name');
            const emailInput = form.querySelector('#contact-email');
            const messageInput = form.querySelector('#contact-message');
            const maxMsg = Number(form.getAttribute('data-max-message') || '2000');

            if (!nameInput.checkValidity() || !emailInput.checkValidity() || !messageInput.checkValidity()) {
              setStatus('Please fill in your name, a valid email, and a message.', 'error');
              form.reportValidity();
              return;
            }
            if (messageInput.value.length > maxMsg) {
              setStatus('Message is too long. Please shorten it.', 'error');
              return;
            }

            const elapsed = Date.now() - lastSend();
            if (elapsed < THROTTLE_MS) {
              const wait = Math.ceil((THROTTLE_MS - elapsed) / 1000);
              setStatus('Please wait ' + wait + 's before sending another message.', 'error');
              return;
            }

            const service_id = form.getAttribute('data-service-id') || '';
            const template_id = form.getAttribute('data-template-id') || '';
            const user_id = form.getAttribute('data-public-key') || '';
            if (!service_id || !template_id || !user_id) {
              setStatus('Contact form is not configured. Use the email link below.', 'error');
              return;
            }

            if (submitBtn) submitBtn.disabled = true;
            setStatus('Sending…', '');

            try {
              const res = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  service_id: service_id,
                  template_id: template_id,
                  user_id: user_id,
                  template_params: {
                    from_name: nameInput.value.trim(),
                    reply_to: emailInput.value.trim(),
                    message: messageInput.value.trim(),
                    page_url: form.getAttribute('data-page-url') || location.href,
                    site_name: form.getAttribute('data-site-name') || '',
                  },
                }),
              });
              if (!res.ok) {
                throw new Error('HTTP ' + res.status);
              }
              markSent();
              form.reset();
              setStatus('Thanks — your message was sent. We will reply by email.', 'success');
            } catch (err) {
              setStatus(
                'Could not send right now. Please email us directly using the address below.',
                'error',
              );
            } finally {
              if (submitBtn) submitBtn.disabled = false;
            }
          });
        })();
      </script>
    )
  }

  {
    emailjsReady && (
      <style is:global>
        .contact-form {
          display: grid;
          gap: var(--space-2);
          margin: var(--space-4) 0;
          padding: var(--space-4);
          border: 1px solid var(--color-border);
          border-radius: var(--radius);
          background: var(--color-bg-elevated);
        }
        .contact-form .hp {
          position: absolute;
          width: 1px;
          height: 1px;
          padding: 0;
          margin: -1px;
          overflow: hidden;
          clip: rect(0, 0, 0, 0);
          white-space: nowrap;
          border: 0;
        }
        #contact-submit:disabled {
          opacity: 0.65;
          cursor: not-allowed;
        }
      </style>
    )
  }
</BaseLayout>
