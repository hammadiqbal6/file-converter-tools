---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import AuthorBox from '../../components/ui/AuthorBox.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import { guides, getGuide } from '../../data/guides';
import { getTool, toolPath } from '../../data/tools';
import { absoluteUrl, siteConfig } from '../../config/site';

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug } }));
}

const guide = getGuide(Astro.params.slug!);
if (!guide) throw new Error('Unknown guide');

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.description,
  datePublished: guide.datePublished,
  dateModified: guide.dateModified,
  author: { '@type': 'Organization', name: siteConfig.organizationName },
  publisher: { '@type': 'Organization', name: siteConfig.organizationName, url: absoluteUrl('/') },
  mainEntityOfPage: absoluteUrl(`/guides/${guide.slug}/`),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: absoluteUrl('/guides/') },
    { '@type': 'ListItem', position: 3, name: guide.title, item: absoluteUrl(`/guides/${guide.slug}/`) },
  ],
};
---

<BaseLayout
  title={guide.title}
  description={guide.description}
  canonicalPath={`/guides/${guide.slug}/`}
  ogType="article"
  jsonLd={[articleLd, breadcrumbLd]}
>
  <div class="container">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Guides', href: '/guides/' }, { name: guide.title }]} />
    <article class="content-prose">
      <h1>{guide.title}</h1>
      <p class="meta-row">
        <span>Updated <time datetime={guide.dateModified}>{guide.dateModified}</time></span>
      </p>
      <div class="answer-box"><p>{guide.answerFirst}</p></div>
      <div class="takeaways">
        <h2>Key takeaways</h2>
        <ul>{guide.takeaways.map((t) => <li>{t}</li>)}</ul>
      </div>
      {guide.sections.map((s) => (
        <section>
          <h2>{s.h2}</h2>
          <div set:html={s.html} />
        </section>
      ))}
      <AdSlot placement="in-article" />
      <section class="faq">
        <h2>FAQ</h2>
        {guide.faqs.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </section>
      <h2>Sources</h2>
      <ul>
        {guide.sources.map((s) => (
          <li><a href={s.href} rel="noopener noreferrer">{s.label}</a></li>
        ))}
      </ul>
      <AuthorBox datePublished={guide.datePublished} dateModified={guide.dateModified} />
    </article>
    <section class="related">
      <h2>Related tools</h2>
      <div class="card-grid">
        {guide.relatedTools.map((slug) => {
          const t = getTool(slug);
          return t ? (
            <a class="tool-card" href={toolPath(t.slug)}>
              <h3>{t.name}</h3>
              <p>{t.description}</p>
            </a>
          ) : null;
        })}
      </div>
    </section>
  </div>
</BaseLayout>
