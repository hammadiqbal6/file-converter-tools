---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, absoluteUrl } from '../config/site';
import { tools, categories, toolPath } from '../data/tools';
import { guides } from '../data/guides';

const title = 'Private In-Browser File Converters';
const description =
  'Convert YAML, JSON, CSV, HEIC, PSD, SVG, STL, and bank-statement PDFs in your browser. Free niche converters — your file never leaves your device.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': absoluteUrl('/#website'),
    name: siteConfig.name,
    url: absoluteUrl('/'),
    description: siteConfig.tagline,
    inLanguage: 'en-US',
    publisher: { '@id': absoluteUrl('/#organization') },
    author: { '@id': siteConfig.personId },
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/" jsonLd={jsonLd} prefetch={['/tools/', '/guides/']} ogImage="/og/home.svg">
  <div class="container">
    <section class="hero">
      <p class="eyebrow">{siteConfig.name}</p>
      <h1>Private file converters that never upload your files</h1>
      <p class="lead answer-first">
        LocalFile Convert runs niche format pairs — YAML↔JSON, CSV, Markdown, PSD, HEIC, SVG, STL, and text-based bank
        PDFs — entirely in your browser with on-demand libraries. Choose a tool, convert on-device, and download the
        result. Your file never leaves your device; check the Network tab during conversion to verify.
      </p>
      <p class="meta-row author-meta">
        <span><strong>Author:</strong> <a href="/authors/" rel="author">{siteConfig.defaultAuthor.name}</a></span>
        <span><strong>Updated:</strong> <time datetime={siteConfig.lastUpdated}>{siteConfig.lastUpdated}</time></span>
      </p>
      <div class="btn-group">
        <a class="btn btn-primary" href="/tools/">Browse converters</a>
        <a class="btn btn-secondary" href="/guides/privacy-first-conversion/">Why in-browser?</a>
      </div>
    </section>

    <section aria-label="Popular tools">
      <h2>Popular converters</h2>
      <div class="card-grid">
        {tools.slice(0, 9).map((t) => (
          <a class="tool-card" href={toolPath(t.slug)}>
            <h3>{t.name}</h3>
            <p>{t.answerFirst.slice(0, 120)}…</p>
          </a>
        ))}
      </div>
      <p style="margin-top:1rem"><a href="/tools/">View all {tools.length} tools →</a></p>
    </section>

    <section class="related" aria-label="Categories">
      <h2>Browse by category</h2>
      <div class="card-grid">
        {Object.values(categories).map((c) => (
          <a class="tool-card" href={`/category/${c.slug}/`}>
            <h3>{c.name}</h3>
            <p>{c.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="related content-prose">
      <h2>How it works</h2>
      <p>
        Each tool loads a minimal page shell first. Heavy libraries (WASM decoders, pdf.js, Three.js, ag-psd) download
        only after you choose a file or click Convert. Processing happens on-device — check the Network tab to verify
        your document is never posted to a server.
      </p>
      <div class="takeaways">
        <h3>Key takeaways</h3>
        <ul>
          <li>No account and no upload queue.</li>
          <li>Answer-first explainers on every tool page for search and AI citation.</li>
          <li>AdSense-ready layout with reserved slots — ads stay disabled until you configure a publisher ID.</li>
        </ul>
      </div>
    </section>

    <section class="related">
      <h2>Guides</h2>
      <div class="card-grid">
        {guides.slice(0, 6).map((g) => (
          <a class="tool-card" href={`/guides/${g.slug}/`}>
            <h3>{g.title}</h3>
            <p>{g.description}</p>
          </a>
        ))}
      </div>
      <p style="margin-top:1rem"><a href="/guides/">All guides →</a></p>
    </section>
  </div>
</BaseLayout>
