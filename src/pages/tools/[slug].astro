---
/**
 * Only the active tool component is imported per path so vendor-pdf / vendor-heic
 * chunks are not module-preloaded on unrelated tool pages.
 */
import ToolLayout from '../../layouts/ToolLayout.astro';
import { tools, getTool } from '../../data/tools';

export function getStaticPaths() {
  return tools.map((t) => ({ params: { slug: t.slug } }));
}

const { slug } = Astro.params;
const tool = getTool(slug!);
if (!tool) throw new Error(`Unknown tool ${slug}`);

const loaders: Record<string, () => Promise<{ default: any }>> = {
  'yaml-to-json': () => import('../../components/tools/YamlJsonTool.astro'),
  'json-to-yaml': () => import('../../components/tools/YamlJsonTool.astro'),
  'json-to-csv': () => import('../../components/tools/CsvJsonTool.astro'),
  'csv-to-json': () => import('../../components/tools/CsvJsonTool.astro'),
  'xml-to-json': () => import('../../components/tools/XmlJsonTool.astro'),
  'toml-to-json': () => import('../../components/tools/TomlJsonTool.astro'),
  'markdown-to-html': () => import('../../components/tools/MarkdownHtmlTool.astro'),
  'psd-to-png': () => import('../../components/tools/PsdToPngTool.astro'),
  'heic-to-jpg': () => import('../../components/tools/HeicToJpgTool.astro'),
  'image-format-converter': () => import('../../components/tools/ImageFormatTool.astro'),
  'svg-to-png': () => import('../../components/tools/SvgToPngTool.astro'),
  'stl-to-obj': () => import('../../components/tools/StlTool.astro'),
  'stl-to-gcode': () => import('../../components/tools/StlGcodeTool.astro'),
  'pdf-bank-statement-to-csv': () => import('../../components/tools/PdfBankTool.astro'),
};

const mod = await loaders[tool.slug]();
const ToolComponent = mod.default;

const modeProps: Record<string, Record<string, string>> = {
  'yaml-to-json': { mode: 'yaml-to-json' },
  'json-to-yaml': { mode: 'json-to-yaml' },
  'json-to-csv': { mode: 'json-to-csv' },
  'csv-to-json': { mode: 'csv-to-json' },
};
const extra = modeProps[tool.slug] || {};
---

<ToolLayout tool={tool}>
  <ToolComponent slot="tool" {...extra} />
</ToolLayout>
